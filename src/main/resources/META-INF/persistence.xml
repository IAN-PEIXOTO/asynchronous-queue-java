<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="Ian" transaction-type="RESOURCE_LOCAL">
        <!-- Provedor JPA (Exemplo usando Hibernate) -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.estudojava.model.ConsultaCep</class>
    
        <properties>
            <!-- Conexão com o PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:1234/FILA_CEPS"/>
            <property name="jakarta.persistence.jdbc.user" value="IAN"/>
            <property name="jakarta.persistence.jdbc.password" value="200714"/>

            <!-- Configurações do Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            
            <!-- Cria/Atualiza as tabelas automaticamente com base nas suas classes Java -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>
